# Comma- or newline-separated Hugging Face access tokens.
# The backend round-robins across them and rotates on HTTP 429/503.
# A single HF_TOKEN also works.
HF_TOKENS=hf_xxx,hf_yyy

# Model tiers (any model served by HF Inference Providers).
SMALL_MODEL=meta-llama/Llama-3.1-8B-Instruct
LARGE_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Judge defaults to LARGE_MODEL when left blank.
JUDGE_MODEL=

# Per-call generation limits.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1200

# CORS origins for the frontend (comma-separated allowed).
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
